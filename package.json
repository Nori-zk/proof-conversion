{
  "name": "@nori-zk/proof-conversion",
  "version": "0.8.23",
  "description": "Verifying zkVM proofs inside o1js circuits, to generate Mina compatible proof",
  "author": "",
  "license": "Apache-2.0",
  "keywords": [
    "mina-zkapp",
    "mina-zk-app",
    "mina-dapp",
    "zkapp"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/src/index.js"
    },
    "./min": {
      "import": "./build/src/index.min.js"
    },
    "./wasm-utils": {
      "import": "./build/src/index.wasm_utils.js"
    },
    "./validation": {
      "import": "./build/src/api/validation/index.js"
    },
    "./compute/plan": {
      "import": "./build/src/compute/plan.js"
    },
    "./compute/processPool": {
      "import": "./build/src/compute/processPool.js"
    },
    "./compute/plans/platform": {
      "import": "./build/src/compute/plans/platform/index.js"
    }
  },
  "bin": {
    "nori-proof-converter": "./build/src/bin/cli-wrapper.js"
  },
  "scripts": {
    "build": "tsc",
    "buildw": "tsc --watch",
    "build:precompute:towers": "npm run build && node build/src/towers/precompute.js",
    "build:precompute:lines": "npm run build && node build/src/plonk/mm_loop/precompute_lines.js",
    "build:precompute": "npm run build:precompute:towers && npm run build:precompute:lines",
    "coverage": "node node_modules/jest/bin/jest.js --coverage",
    "format": "prettier --check --ignore-unknown --ignore-path .prettierignore **/*",
    "format:fix": "prettier --write --ignore-unknown --ignore-path .prettierignore **/*",
    "test": "npm run build && node --max-old-space-size=65536 --",
    "test:e2e": "npm run build && npm run test build/src/plonk/mm_loop/e2e_test.js && npm run test build/src/plonk/piop/e2e_test.js && npm run test build/src/plonk/piop/e2e_playground.js && npm run test build/src/groth/e2e_test.js && npm run test build/src/plonk/e2e_test.js",
    "test:compute": "npm run build && node ./build/src/compute/compute_test.js",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:validation": "jest --testMatch '**/guards/test.spec.ts'",
    "lint": "eslint src/*",
    "lint:fix": "eslint src/* --fix",
    "relink": "npm unlink nori-proof-converter && npm run build && npm link"
  },
  "dependencies": {
    "@nori-zk/proof-conversion-utils": "^1.0.1",
    "commander": "14.0.2",
    "esm-iso-logger": "1.0.2",
    "ethers": "^6.16.0"
  },
  "peerDependencies": {
    "o1js": "3.0.0-mesa.698ca"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "eslint": "^9.39.2",
    "eslint-plugin-o1js": "^0.4.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "files": [
    "build/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
